# Copiar a .env.local (desarrollo) o cargar en Vercel → Settings → Environment Variables.

# Supabase (Project Settings → API). Obligatorias.
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=TU-ANON-KEY

# Dirección pública de la tienda (links de los emails y de Mercado Pago).
NEXT_PUBLIC_SITE_URL=https://www.tu-dominio.com.ar

# Emails (Resend — https://resend.com). Opcional: sin esto no se envían emails.
# RESEND_API_KEY=re_xxxxxxxx
# EMAIL_FROM=Hogar Lina <pedidos@tu-dominio.com.ar>
# HOGAR_NOTIF_EMAIL=tu-mail@ejemplo.com   # adónde llegan los avisos de pedidos

# Mercado Pago (Checkout Pro). Opcional: sin las tres, la tienda cobra solo por transferencia.
# MP_ACCESS_TOKEN=APP_USR-...
# MP_WEBHOOK_SECRET=...
# SUPABASE_SERVICE_ROLE_KEY=...           # SOLO en el servidor (Vercel). Nunca en el navegador.
